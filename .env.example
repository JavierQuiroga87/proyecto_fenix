
# Configuracion del SDK Boto3 y LocalStack
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# Imagen de LocalStack y Token (para compose.yaml de la catedra)
# LOCALSTACK_IMAGE=localstack/localstack:2026.10.0
# LOCALSTACK_AUTH_TOKEN=

# Identificacion del Grupo y Recursos
GROUP_ID=grupo01
PROJECT=fenix
QUEUE_PREFIX=fenix-grupo01

# Nombres de referencia de colas
SQS_QUEUE_NAME=fenix-events-queue
SQS_DLQ_NAME=fenix-events-dlq

# Seguridad Webhook HMAC-SHA256
# Generar una clave con:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=REEMPLAZAR_POR_UNA_CLAVE_SEGURA
WEBHOOK_PORT=8000

# Proveedor de notificaciones: console, telegram o slack
NOTIFY_PROVIDER=console

# Parametros para Telegram
TELEGRAM_BOT_TOKEN=REEMPLAZAR_POR_TOKEN_REAL
TELEGRAM_CHAT_ID=REEMPLAZAR_POR_CHAT_ID_REAL

# Parametros para Slack
SLACK_WEBHOOK_URL=REEMPLAZAR_POR_WEBHOOK_REAL
