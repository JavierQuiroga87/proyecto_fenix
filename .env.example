# Configuracion del SDK Boto3 y LocalStack
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# Imagen de LocalStack y Token (para compose.yaml de la cátedra)
# LOCALSTACK_IMAGE=localstack/localstack:2026.10.0
# LOCALSTACK_AUTH_TOKEN=

# Identificacion del Grupo y Recursos
GROUP_ID=grupo01
PROJECT=fenix
QUEUE_PREFIX=fenix-grupo01

# Nombres de referencia de colas (utilizados por la CLI y pruebas)
SQS_QUEUE_NAME=fenix-events-queue
SQS_DLQ_NAME=fenix-events-dlq

# Seguridad Webhook HMAC-SHA256
# Generar una clave segura con: python -c "import secrets; print(secrets.token_urlsafe(32))" 
WEBHOOK_SECRET=clave_secreta_fenix_super_segura_12345
WEBHOOK_PORT=8000

# Proveedor de Notificaciones Externas (console, telegram o slack)

NOTIFY_PROVIDER=telegram

# Parámetros para Telegram
TELEGRAM_BOT_TOKEN=dummy_token
TELEGRAM_CHAT_ID=123456789

# Parámetros para Slack (o Mock de pruebas)
SLACK_WEBHOOK_URL=http://localhost:8000/mock-slack